    Name = "🍋 Sell Lemons Farm | Obsidian UI",
    LoadingTitle = "Loading Auto Farm...",
    LoadingSubtitle = "by Obsidian",
    ConfigurationSaving = {
       Enabled = false,
    },
    Discord = {
       Enabled = false,
    },
    KeySystem = false,
})

